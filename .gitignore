# Dependencies (Covers root and all inner folders)
node_modules/
# Production Build Outputs
dist/
dist-ssr/
.next/

# Environment Variables & Secrets (Crucial for Monorepos)
.env
.env.local
.env.*.local
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Media Uploads (From the second list - stops local test images/files from polluting Git)
uploads/

# Databases / ORMs (If you use Prisma later)
/src/generated/prisma

# Editor and System Directories
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.sw?
